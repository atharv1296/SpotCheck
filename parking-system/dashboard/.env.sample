###############################################
# Oracle Database configuration for Django
###############################################

# Preferred: single DSN string in host:port/service format
# ORACLE_DSN=localhost:1521/orclpdb

# Or specify components to build DSN
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=orclpdb

# Credentials
ORACLE_USER=system
ORACLE_PASSWORD=change_me

# Optional: force thick mode (requires Instant Client)
# ORACLE_THICK_MODE=1
# ORACLE_CLIENT_LIB_DIR=C:\\oracle\\instantclient_19_23
